pkgname=pytuna-alacritty-config
pkgdesc='pytunaOS config for alacritty'
pkgver=1.0.0
pkgrel=1
arch=('any')
url="https://github.com/pytunaOS"
license=(GPL-3.0-only)
depends=('alacritty' 'ttf-jetbrains-mono-nerd')

package() {
  install -d "${pkgdir}/etc/skel"
  cp -rv "${startdir}/etc/skel/.config" "${pkgdir}/etc/skel"
}
