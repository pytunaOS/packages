_create_live_user() {
    if ! getent group liveuser >/dev/null; then
        if getent group 1000 >/dev/null; then
            groupadd liveuser
        else
            groupadd --gid 1000 liveuser
        fi
    fi

    if ! id liveuser >/dev/null 2>&1; then
        local user_args=(
            --gid liveuser
            --create-home
            --shell /usr/bin/bash
            --comment "pytunaOS Live User"
        )

        if ! getent passwd 1000 >/dev/null; then
            user_args+=(--uid 1000)
        fi

        useradd "${user_args[@]}" liveuser
    fi

    local group

    for group in \
        adm \
        audio \
        network \
        optical \
        power \
        rfkill \
        storage \
        users \
        uucp \
        video \
        wheel
    do
        if getent group "${group}" >/dev/null; then
            usermod --append --groups "${group}" liveuser
        fi
    done

    passwd --delete liveuser
}
