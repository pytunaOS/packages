{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"type": "file",
    	"source": "~/.config/fastfetch/ascii/pytuna_logo.txt",
    	"color": {"1": "#BF1D06"}
    },
    "display": {
        "separator": "  "
    },
    
    "modules": [
        {
            "type": "os",
            "key": "  󰀥",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "  ",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "format": "{1} v{4}",
            "key": "  󰘳",
            "keyColor": "green"
        },                
        {
            "type": "packages",
            "key": "  󰏗",
            "keyColor": "green"
        },
        "break",
        {
            "type": "display",
            "key": "  󰹑",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "  ",
	        "format": "{2}",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": "  ",
            "format": "{1}",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "cpu",
            "format": "{1}",
            "key": "  ",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "format": "{1} {2} {12}",
            "key": "  󰋵",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "key": "  󰀚",
            "keyColor": "blue"
        },    

        {
            "type": "disk",
            "key": "  󰀚",
            "keyColor": "magenta"
        },  
        {
            "type": "uptime",
            "key": "  󱦟",
            "keyColor": "red"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "square"
        },
    ]
}
