# Maintainer: Wendel Peterson <pytunaOS@proton.me>

pkgname=pytuna-calamares-config
pkgver=1.0.0
pkgrel=1
pkgdesc="Calamares configuration for pytunaOS"
arch=('any')
url="https://github.com/pytunaOS/$pkgname"
license=('GPL-3.0-or-later')
depends=('calamares')

package() {
  cd "${srcdir}/pytuna-calamares-config-${pkgver}"

  install -d "${pkgdir}/etc/calamares"
  install -d "${pkgdir}/usr/share/calamares/branding"
  install -d "${pkgdir}/usr/share/calamares/qml/calamares"

  install -Dm644 usr/share/calamares/settings.conf \
      "${pkgdir}/etc/calamares/settings.conf"

  cp -a etc/calamares/modules \
      "${pkgdir}/etc/calamares/"

  cp -a usr/share/calamares/branding/pytuna \
      "${pkgdir}/usr/share/calamares/branding/"

  cp -a usr/share/calamares/qml/calamares/slideshow \
      "${pkgdir}/usr/share/calamares/qml/calamares/"
}
