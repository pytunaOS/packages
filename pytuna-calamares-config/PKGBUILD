# Maintainer: Wendel Peterson <pytunaOS@proton.me>

pkgname=pytuna-calamares-config
pkgver=1.0.1
pkgrel=3
pkgdesc="Calamares configuration for pytunaOS"
arch=('any')
url="https://github.com/pytunaOS/pytuna-calamares-config"
license=('GPL-3.0-or-later')

depends=('calamares')
makedepends=('git')

source=("${pkgname}::git+https://github.com/pytunaOS/${pkgname}.git")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/${pkgname}"

    install -Dm644 usr/share/calamares/settings.conf "${pkgdir}/etc/calamares/settings.conf"

    install -d "${pkgdir}/etc/calamares"
    cp -a etc/calamares/modules "${pkgdir}/etc/calamares/"

    install -d "${pkgdir}/usr/share/calamares/branding"
    cp -a usr/share/calamares/branding/pytuna "${pkgdir}/usr/share/calamares/branding/"

    install -Dm644 etc/xdg/autostart/pytuna-calamares.desktop "${pkgdir}/etc/xdg/autostart/pytuna-calamares.desktop"

}
